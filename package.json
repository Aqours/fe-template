{
  "name": "fe-template",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "description": "",
  "scripts": {
    "prepare": "husky",
    "husky:pre-commit": "lint-staged",
    "husky:commit-msg": "commitlint --edit ${1}",
    "test": "pnpm run tscheck",
    "build:references": "tsc --build",
    "tscheck": "pnpm -r --parallel exec tsc --noEmit"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "browserslist": [
    "Firefox ESR",
    "> 1% in CN",
    "> 2% in US",
    "last 5 versions",
    "not ie 6-11"
  ],
  "keywords": [],
  "author": "Aqours",
  "license": "ISC",
  "devDependencies": {
    "@changesets/cli": "^2.29.6",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "dotenv": "^17.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "npm-check-updates": "^18.0.3",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2"
  }
}
