{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": ".ts-build",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "pretty": true,
    "strict": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "exclude": ["node_modules"]
  }
}
